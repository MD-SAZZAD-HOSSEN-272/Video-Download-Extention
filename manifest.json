{
  "manifest_version": 3,
  "name": "Video Downloader made by Sazzad",
  "version": "1.0.0",
  "description": "Detect videos on a page and download them (IDM-style).",
  "permissions": ["webRequest", "downloads", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.facebook.com/*", "*://fb.watch/*"],
      "js": ["site.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Video Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
